# Copy this file to .env and fill in the values.
# .env is not committed. Share the real values through a password manager.

# TigerData service URL. SSL is required.
# postgresql://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Signs the who-cookie, the edit cookie, and the short-lived flash cookies.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional. Leave this empty and anyone who can open the site can add and edit.
# Set a shared phrase and every add, edit, or delete asks for it once per browser.
EDIT_PASSCODE=
